    <div class="modal fade" id="modal_update_fournisseur" tabindex="-1" role="dialog" aria-labelledby="modalUpdateFournisseurLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="modalUpdateFournisseurLabel">Modifier Fournisseur</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="form_update_fournisseur">
                <div class="modal-body">
                    <input type="hidden" id="fournisseur_id" name="id_four">
                    <div class="form-group">
                        <label for="nom">Nom</label>
                        <input type="text" class="form-control" id="nom" name="nom">
                        <small class="error_text text-danger"></small>
                    </div>
                    <div class="form-group">
                        <label for="adresse">Adresse</label>
                        <input type="text" class="form-control" id="adresse" name="adresse">
                        <small class="error_text text-danger"></small>
                    </div>
                    <div class="form-group">
                        <label for="telephone">Téléphone</label>
                        <input type="number" class="form-control" id="telephone" name="telephone">
                        <small class="error_text text-danger"></small>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" class="form-control" id="email" name="email">
                        <small class="error_text text-danger"></small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

