  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1>Article</h1>
          </div>
          <div class="col-sm-6">
            {% for message in app.flashes('privmessage') %}
              <div class=" alert alert-warning ">
                  {{ message }}
              </div>
          {% endfor %}
          </div>
        </div>
      </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
      <!-- Default box -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Gestion des articles</h3>
          <div class="float-right">
                <button class="btn btn-info" onclick="window.location.reload()" ><span> <i class="fas fa-sync-alt"></i></span> Recharger </button>
                <button class="btn btn-success" id="btn_new_article" > Ajouter <span><i class="fas fa-plus"></i> </span></button>
            </div>
        </div>
        <div class="card-body">
            <table id="table_article" class="table table-bordered table-striped">
                  <thead>
                    <tr>
                      <th>Nom </th>
                      <th>Description </th>
                      <th>Prix </th>
                      <th>Min quantite </th>
                      <th>Quantite</th>
                      <th>Image</th>
                      <th>Categorie</th>
                      <th>Depot </th>
                      <th class="datatable-nosort">Operations </th>
                    </tr>
                  </thead>
                  <tbody>
                  {% for a in article %}
                      <tr> 
                        <td> {{a.nom}}</td>
                        <td> {{a.description}}</td>
                        <td> {{a.prix}}</td>
                        <td> {{a.minQuantite}}</td>
                        <td class="text-center">
                        {% if a.quantite == 0 %}
                          <span class="badge bg-danger"> {{a.quantite}} </span>
                          {% else %}
                            {% if a.minQuantite >= a.quantite %}
                                <span class="badge bg-warning"> {{a.quantite}} </span>
                            {% else %}
                              <span class="badge bg-success"> {{a.quantite}} </span>
                            {% endif %}
                        {% endif %}
                       
                         </td>
                        <td>  <a href="{{asset("/main/images/")}}{{a.image}}" target="_blank"><img alt="{{a.nom}}" src="{{asset("/main/images/")}}{{a.image}}" class="article_image"/> </a></td>
                        <td> {{a.idCategorie.nomCategorie}}</td>
                        <td> {{a.idDepot.adresse}}</td>
                        <td> 
                          <button data-id="{{a.id}}" class="btn btn-primary btn_update_article"> <span><i class="fas fa-pencil-alt"></i> </span></button>
                          <button data-id="{{a.id}}" class="btn btn-danger btn_delete_article" > <span><i class="fas fa-trash"></i> </span></button>
                        </td>
                      
                    </tr>
                    </tr>
                  {% endfor %}

                  </tbody>
                </table>
        </div>
      </div>
      <!-- /.card -->

    </section>
    <!-- /.content -->
    </div>

  <!-- /.content-wrapper -->

   {# start madal #}
 <div class="modal fade" id="modal_new_article" tabindex="-1" role="dialog" aria-labelledby="newArticleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header ">
              <h4 class="modal-title">Nouveau Article</h4>
              <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
            <form id="form_new_article">
                <div class="modal-body">
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="nom">Nom</label>
                        </div>
                        <div class="form-group col-md-8">
                            <input type="text" class="form-control" name="nom" id="newNom">
                            <small class="error_text text-danger"></small>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="description">Description</label>
                        </div>
                        <div class="form-group col-md-8">
                            <input type="text" class="form-control" name="description" id="newDescription">
                            <small class="error_text text-danger"></small>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="prix">Prix</label>
                        </div>
                        <div class="form-group col-md-8">
                            <input type="number" class="form-control" name="prix" id="newPrix">
                            <small class="error_text text-danger"></small>
                        </div>
                    </div>
                     <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="prix">Min quantite</label>
                        </div>
                        <div class="form-group col-md-8">
                            <input type="number" class="form-control" name="minquantite" id="newMinquantite">
                            <small class="error_text text-danger"></small>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="quantite">Quantité</label>
                        </div>
                        <div class="form-group col-md-8">
                            <input type="number" class="form-control" name="quantite" id="newQuantite">
                            <small class="error_text text-danger"></small>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="image">Image</label>
                        </div>
                        <div class="form-group col-md-8">
                            <input type="file" class="form-control" name="image" style="display:none" id="image_add">
                            <span class="btn btn-success col fileinput-button dz-clickable" id="add_file">
                                <i class="fas fa-plus"></i>
                                <span>Add files</span>
                            </span>
                            <small class="error_text text-danger"></small>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="categorie">Catégorie</label>
                        </div>
                        <div class="form-group col-md-8">
                            <select class="form-control" name="categorie" id="newCategorie">
                              <option value=""> -- </option>
                                {% for c in categorie %}
                                <option value="{{c.id}}">{{c.nomCategorie}}</option>
                                {% endfor %}
                            </select>
                            <small class="error_text text-danger"></small>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="depot">Dépôt</label>
                        </div>
                        <div class="form-group col-md-8">
                            <select class="form-control" name="depot" id="newDepot">
                              <option value=""> -- </option>
                                {% for d in depot %}
                                <option value="{{d.id}}">{{d.adresse}}</option>
                                {% endfor %}
                            </select>
                            <small class="error_text text-danger"></small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

      {# end modal #}

