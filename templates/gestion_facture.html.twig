      <!-- Default box -->

        <div class="card">
             <div class="card-header">
          <h3 class="card-title">Gestion des factures</h3>
            <div class="float-right">
                {# <button class="btn btn-info" onclick="window.location.reload()" ><span> <i class="fas fa-sync-alt"></i></span> Recharger </button>
                <button class="btn btn-success" id="btn_new_depot" > Ajouter <span><i class="fas fa-plus"></i> </span></button> #}

            </div>
        
        </div>
        <div class="card-body">
                <table id="table_facture" class="table table-bordered table-striped">
                  <thead>
                  <tr>
                    {# <th>Date de paimenet </th> #}
                    <th>Totale</th>
                    <th>Mode de paiment</th>
                    <th class="datatable-nosort">Operations </th>
                  </tr>
                  </thead>
                  <tbody>
                  {% for f in facture %}
                    {% if f.totale %}
                        <tr> 
                        {# <td> {{f.DatePaiement ? f.DatePaiement|date('d-m-Y') : ''}}</td> #}
                        <td> {{f.totale}} <b> DH</b></td>
                        {% if f.modePaiment %}
                          <td> {{f.modePaiment.libelle}}</td>
                          {% else %}
                          <td> --</td>
                        {% endif %}
                        <td> 
                          {# <button data-id="{{f.id}}" class="btn btn-primary btn_update_depot"> <span><i class="fas fa-pencil-alt"></i> </span></button>
                          <button data-id="{{f.id}}" class="btn btn-danger btn_delete_depot" > <span><i class="fas fa-trash"></i> </span></button> #}
