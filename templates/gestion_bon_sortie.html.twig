<div class="modal fade" id="modal_new_bon_sortiedetail">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <!-- Modal header -->
            <div class="modal-header">
                <h4 class="modal-title">Details Bon de sortie</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <!-- Form for new exit voucher details -->
            <form id="form_new_bonSortDetails">
                <div class="modal-body">
                    <input type="hidden" id="bon_sortD_id" name="bon_sortD_id">

                    <!-- Quantity input field -->
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label>Quantite</label>
                                <input class="form-control" name="quantite" id="quantiteDbs">
                            <small class="error_text text-danger"></small>
                            </div>
                        </div>
                    </div>

                    <!-- Article selection field -->
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label>Article</label>
                                <select class="form-control select2" name="article" id="article" data-placeholder="choisir un article" >
                                    {% for a in articles %}
                                        <option value="{{a.id}}">{{a.nom}}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal footer with save button -->
                <div class="modal-footer justify-content-between">
                    <button type="submit" class="btn btn-success">Enregistrer</button>
                </div>
            </form>

            <!-- Card displaying list of exit voucher details -->
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Liste des details de bons de sortie</h3>
                </div>
                <div class="card-body">
                    <table id="table_list_detail" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Quantite</th>
                                <th>Article</th>
                                <th class="datatable-nosort">Operations</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dynamic content goes here -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Close button for the modal -->
            <button type="button" class="btn btn-default" data-dismiss="modal">fermer</button>
        </div>
    </div>
</div>


